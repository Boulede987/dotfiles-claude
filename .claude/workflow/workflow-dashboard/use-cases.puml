@startuml workflow-dashboard-use-cases
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor<<new>> #FFF3B0
  BorderColor<<new>> #C99A00
}

actor Developer as dev
actor "Claude Code session" as claude
actor "File system\n(.claude/workflow/**)" as fs

rectangle "workflow-dashboard (standalone process, per project)" {
  usecase "Start dashboard\nfor a project" as UC1
  usecase "Switch between feature tabs\n(ongoing features; closed ones\nin a Closed tab; marker dot\nwhen awaiting validation)" as UC2 <<new>>
  usecase "Read documents to validate\nin the To validate tab\n(newest entry = awaiting-validation)" as UC3 <<new>>
  usecase "See each document in place\n(images inline, text as plain text,\nreason when unshowable; link kept)" as UC4 <<new>>
  usecase "Browse feature timeline\n(increment > phase, gate, status,\noverride, commit hash)" as UC5
  usecase "Check requirements progress\n(NEEDS.md section 2, collapsed)" as UC6
  usecase "See parse errors\nin the page" as UC7
  usecase "Refresh live on file change\n(selected tab kept)" as UC8 <<new>>
}

dev --> UC1
dev --> UC2
dev --> UC3
dev --> UC5
dev --> UC6
UC3 ..> UC4 : <<include>>
UC7 ..> UC2 : <<extend>>
UC8 <-- fs
claude --> fs : writes STATE.md /\nNEEDS.md (unaware\nof dashboard)

note bottom of claude
  No hook, no output into
  Claude's context.
end note
@enduml
