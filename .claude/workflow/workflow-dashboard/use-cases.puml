@startuml workflow-dashboard-use-cases
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor<<new>> #FFF3B0
  BorderColor<<new>> #C99A00
}

actor Developer as dev
actor "Claude Code session" as claude
actor "File system\n(.claude/workflow/**)" as fs

rectangle "workflow-dashboard (standalone process, per project)" {
  usecase "Start dashboard\nfor a project" as UC1 <<new>>
  usecase "See where each feature stands\n(current phase + next step)" as UC2 <<new>>
  usecase "Review pending validations\n(newest entry = awaiting-validation)" as UC3 <<new>>
  usecase "Open / preview a pending document\n(link; inline svg/png)" as UC4 <<new>>
  usecase "Browse feature timeline\n(increment > phase, gate, status,\noverride, commit hash)" as UC5 <<new>>
  usecase "Check requirements progress\n(NEEDS.md section 2, collapsed)" as UC6 <<new>>
  usecase "See parse errors\nin the page" as UC7 <<new>>
  usecase "Refresh live on file change" as UC8 <<new>>
}

dev --> UC1
dev --> UC2
dev --> UC3
dev --> UC5
dev --> UC6
UC3 ..> UC4 : <<include>>
UC7 ..> UC2 : <<extend>>
UC8 <-- fs
claude --> fs : writes STATE.md /\nNEEDS.md (unaware\nof dashboard)

note bottom of claude
  No hook, no output into
  Claude's context.
end note
@enduml
